rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 自分のデータだけ読み書きできる
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // プリントのメタデータ(本人のみ)
      match /prints/{printId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 上記以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
